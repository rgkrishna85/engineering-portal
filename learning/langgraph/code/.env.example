# Copy this file to ".env" and put your real key in it. NEVER commit .env to git.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which model to use. Format is "provider:model-name".
# Using Azure OpenAI or OpenAI instead? Change this line (and pip install langchain-openai), e.g.
#   LLM_MODEL=azure_openai:gpt-4o      or      LLM_MODEL=openai:gpt-4o-mini
LLM_MODEL=anthropic:claude-sonnet-5-5

# Optional (Day 28): turn on LangSmith tracing to "see inside" every run
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2-your-key-here
